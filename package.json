{
  "name": "@festapp/invoicesync",
  "version": "0.1.2",
  "description": "Independent invoicing Worker and typed client with immutable private PDFs and BankSync payment facts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/festappnet/invoicesync.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cloudflare": "./dist/worker.js",
    "./email-transport": {
      "types": "./dist/email/aws.d.ts",
      "import": "./dist/email/aws.js"
    },
    "./email-sigv4": {
      "types": "./dist/email/aws-sigv4.d.ts",
      "import": "./dist/email/aws-sigv4.js"
    }
  },
  "files": [
    "dist",
    "services/invoicing/migrations",
    "packages/email-transport/src"
  ],
  "scripts": {
    "build": "pnpm --filter ./packages/invoicing-client run build && pnpm --filter ./services/invoicing run build && node scripts/package.mjs",
    "typecheck": "pnpm --filter ./services/invoicing run typecheck",
    "test": "pnpm --filter ./services/invoicing test && pnpm --filter ./packages/invoicing-client test",
    "test:db": "python -m unittest discover -s services/invoicing/tests -p 'test_*.py' -q",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@festapp/banksync": "0.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/qrcode": "1.5.5",
    "esbuild": "0.28.1",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0"
}
