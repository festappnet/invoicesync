[Unit]
Description=Verify and renew InvoiceSync internal database identity
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/invoicesync/ops/rotate_credentials.py
TimeoutStartSec=180
Restart=on-failure
RestartSec=15min
NoNewPrivileges=true
PrivateTmp=true

